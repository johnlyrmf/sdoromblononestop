rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        );
    }

    function isICTStaff() {
      return activeProfile()
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unitId == 'ICT Unit'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    function isAdmin() {
      return activeProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAnonymousRequester() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function validPublicStatus(status) {
      return status in ['submitted', 'in_review', 'in_progress', 'waiting_for_requester', 'account_created', 'ready_for_activation', 'ready_for_release', 'completed', 'declined'];
    }

    match /users/{userId} {
      allow read: if (
          activeProfile() && (request.auth.uid == userId || isAdmin())
        ) || (
          signedIn()
          && request.auth.uid == userId
          && request.auth.token.email == 'sdo@deped.gov.ph'
        );
      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.auth.token.email == 'sdo@deped.gov.ph'
          && request.resource.data.email == 'sdo@deped.gov.ph'
          && request.resource.data.unitId == 'ICT Unit'
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'active'
        );
      allow update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if isAnonymousRequester()
        && requestId.matches('^[0-9]{9}$')
        && request.resource.data.unitId == 'ICT Unit'
        && request.resource.data.status == 'submitted'
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.trackingNumber == requestId
        && request.resource.data['service'] != null
        && request.resource.data.createdAt != null;

      allow read: if isICTStaff()
        || (signedIn() && resource.data.requesterUid == request.auth.uid);

      allow update: if isICTStaff()
        && request.resource.data.unitId == resource.data.unitId;

      allow delete: if isAdmin();
    }

    // Public code lookup returns only this deliberately minimal projection.
    // Exact reads are allowed; collection listing and client writes are denied.
    match /public_tracking/{trackingCode} {
      allow get: if trackingCode.matches('^[0-9]{9}$');
      allow list: if false;
      allow create: if isAnonymousRequester()
        && trackingCode.matches('^[0-9]{9}$')
        && request.resource.data.keys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'submitted'
        && request.resource.data.updatedAt != null
        && getAfter(/databases/$(database)/documents/requests/$(trackingCode)).data.requesterUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/requests/$(trackingCode)).data.trackingNumber == trackingCode;
      allow update: if isICTStaff()
        && request.resource.data.keys().hasOnly(['status', 'updatedAt'])
        && validPublicStatus(request.resource.data.status)
        && request.resource.data.updatedAt != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && getAfter(/databases/$(database)/documents/requests/$(trackingCode)).data.trackingNumber == trackingCode
        && getAfter(/databases/$(database)/documents/requests/$(trackingCode)).data.status == request.resource.data.status;
      allow delete: if isAdmin();

      match /updates/{updateId} {
        allow get, list: if trackingCode.matches('^[0-9]{9}$');
        allow create: if isICTStaff()
          && request.resource.data.keys().hasOnly(['status', 'message', 'createdAt'])
          && validPublicStatus(request.resource.data.status)
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 1000
          && request.resource.data.createdAt != null
          && getAfter(/databases/$(database)/documents/public_tracking/$(trackingCode)).data.status == request.resource.data.status;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /request_events/{eventId} {
      allow read: if isICTStaff()
        || (
          signedIn()
          && resource.data.visibleToRequester == true
          && resource.data.requesterUid == request.auth.uid
        );
      allow create: if (
          isICTStaff()
          && request.resource.data.senderRole == 'ict'
          && request.resource.data.senderUnit == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unitId
        )
        || (
          signedIn()
          && request.resource.data.senderRole == 'requester'
          && request.resource.data.visibleToRequester == true
          && request.resource.data.requesterUid == request.auth.uid
          && exists(/databases/$(database)/documents/requests/$(request.resource.data.requestId))
          && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.requesterUid == request.auth.uid
        );
      allow update, delete: if isAdmin();
    }

    match /request_documents/{documentId} {
      allow read, write: if isICTStaff();
    }
  }
}
